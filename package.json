{
  "name": "chashack-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot for hackathon team signups, matching and admin management",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:admin": "pnpm --filter admin-ui dev",
    "build:admin": "pnpm --filter admin-ui build",
    "register:commands": "pnpm --filter bot register:commands",
    "aspire": "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=0 aspire",
    "aspire:restore": "pnpm run aspire restore --non-interactive",
    "dev": "pnpm run aspire:restore && pnpm run aspire start && pnpm run aspire ps",
    "dev:stop": "pnpm run aspire stop"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vscode-jsonrpc": "8.2.1"
  }
}
