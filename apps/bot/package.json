{
  "name": "bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"dist/**/*.test.js\"",
    "register:commands": "node dist/register-commands.js",
    "postinstall": "node scripts/no-install-scripts.mjs"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "fastify": "5.12.3",
    "@fastify/static": "10.1.3"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  }
}
