# Non-secret Compose interpolation. For Unraid Custom Stacks, put these lines in its .env field.
CANONICAL_DOMAIN=hackathons.example.org
EDGE_SUBNET=172.30.48.0/24
EDGE_PROXY_IP=172.30.48.2
EDGE_APP_IP=172.30.48.3
TUNNEL_ORIGIN_BIND_IP=192.168.1.10
TUNNEL_ORIGIN_PORT=8081
# Set to the exact source IP/CIDR cloudflared uses to connect to this host.
TUNNEL_PROXY_CIDR=REPLACE_WITH_CLOUDFLARED_SOURCE_IP/32
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:REPLACE_WITH_REVIEWED_DIGEST
POSTGRES_IMAGE=postgres:17.6-alpine@sha256:REPLACE_WITH_REVIEWED_DIGEST
APP_IMAGE=ghcr.io/janne022/chashack-bot:latest
DISCORD_CLIENT_ID=REPLACE_WITH_DISCORD_APPLICATION_ID
DISCORD_GUILD_ID=
ADMIN_IDS=
BOT_LANGUAGE=en
