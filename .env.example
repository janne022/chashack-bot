# Copy to .env and fill in. Never commit .env.

# Discord application credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# OAuth-only sign-in for organizer and participant sessions. In the Discord developer portal →
# your app → OAuth2 → Redirects, add the exact callback URL, e.g.
#   http://localhost:8420/auth/discord/callback
#   https://console.example.com/auth/discord/callback
# and set that same value here (or set PUBLIC_URL, from which it is derived).
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
# Origin the console is reached at; also what the CSRF Origin check trusts and
# what decides the cookie `Secure` flag. Recommended in any deployment.
PUBLIC_URL=

# Optional guild for instant slash-command registration in local development;
# never used to authorize web requests.
DISCORD_GUILD_ID=

# Discord user IDs allowed to use admin commands + admin web UI.
# Also: admins are resolved at runtime from guild permission (ManageGuild | Administrator).
ADMIN_IDS=

# Admin web UI
ADMIN_PORT=8420
# Required: 32+ characters of random signing material. Rotation logs everyone out.
ADMIN_SESSION_SECRET=

# Required runtime PostgreSQL URL for a non-owner, non-superuser role with no DDL.
# Required migration URL for a distinct DDL-capable role on the same database.
# Missing/empty/invalid refuses startup. Never log either value.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Set to 1 to run the admin panel WITHOUT the Discord gateway
# (admin-UI-only deployments, container smoke tests).
SKIP_DISCORD=

# Optional category for team channels (also settable per-guild via
# /hackathon admin team-category or the admin web UI)
TEAM_CATEGORY_ID=

# Optional audit channel: audit log lines are also posted here (channel ID)
AUDIT_CHANNEL_ID=

# Run migrations as a separate deployment job, then omit MIGRATION_DATABASE_URL from the app.
SKIP_DATABASE_MIGRATIONS=
# Comma-separated trusted reverse-proxy IPs/CIDRs only; empty means no trust.
TRUSTED_PROXIES=
